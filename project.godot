config_version=5

[application]

config/name="Critter Carnage"
run/main_scene="uid://bjviy5ac43lwa"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://cjvqbdg00110y"

[autoload]

Global="*uid://0wbwsr3woybg"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[file_customization]

